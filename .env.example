DATABASE_URL=postgresql+psycopg://stakelens:stakelens@localhost:55432/stakelens

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Blocks needed before an event counts as confirmed.
CONFIRMATIONS=3

# Must match the address the UI is served from. These go into the signed message.
SIWE_DOMAIN=localhost:8010
SIWE_URI=http://localhost:8010

# Needed only for /assistant/ask.
ANTHROPIC_API_KEY=

# Deployer for scripts/deploy.py. Leave empty on anvil, which uses its first dev account.
# On a public network use a throwaway key that only ever holds testnet funds.
DEPLOYER_PRIVATE_KEY=

# On a public network: raise this to stay within free RPC plans (Sepolia makes a block every 12s).
POLL_SECONDS=1

# Needed only for `make verify`.
ETHERSCAN_API_KEY=

# Comma-separated backup RPC nodes, tried in order when the primary fails.
RPC_FALLBACK_URLS=

# Needed only by the transaction worker. Keep this out of the API's environment in production.
TX_SIGNER_PRIVATE_KEY=
